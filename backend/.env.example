# ==============================================================================
# DJIE CMS PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# https://github.com/masadjie/djie-cms-pro
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=djie_cms_pro

# Security Tokens & JWT
JWT_SECRET=generate_your_random_secure_secret_key_here_min_32_chars
JWT_EXPIRES_IN=2h

# CORS Whitelist (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Redis Cache (Optional - System will fallback gracefully if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage (Optional - fallback to local storage)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=djie-cms-storage

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
